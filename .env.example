# Generate secure 32+ byte secrets using: openssl rand -hex 32
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/launchproduct
REDIS_URL=redis://localhost:6379
EMAIL_FROM=noreply@launchproduct.io
RESEND_API_KEY=your_resend_api_key_placeholder
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_min_32_chars
PADDLE_API_KEY=your_paddle_api_key_placeholder
NEXT_PUBLIC_API_URL=http://localhost:4000

# Operational endpoints security
# Prometheus metrics scrape token (/api/metrics requires Authorization: Bearer <token>)
# If not configured, /api/metrics returns 404.
# METRICS_TOKEN=your_metrics_token_secret_for_prometheus

# Bull Board queue UI (/admin/queues) should stay disabled unless actively diagnosing queues.
# Only mounted when BOTH BULL_BOARD_USER and BULL_BOARD_PASSWORD are set, and password is at least 24 characters.
# BULL_BOARD_USER=queue-operator
# BULL_BOARD_PASSWORD=replace_with_at_least_24_char_secure_password